@misc{Beau2026ent2,
  author = {Beau, J.},
  title = {{Two Entanglement Entropies of the Conjugate Weil Pair: the Admissible Pair Sector and the Full Residual Rank}},
  journal = {Working paper},
  year = {2026},
  note = {Entanglement sub-programme "E2" paper: separates the admissible pair entropy
 $S_{\mathrm{ent}}^{\mathrm{adm}}=\log 2$ from the full residual-rank entropy
 $S_{\mathrm{ent}}(n)=\log r_{\mathrm{pair}}(n)$. The first requires E2's own explicit
 hypothesis [H-carrier] and Q3's independent [H-inv]; the rank-three threshold is a supplied O23
 selection rule and no mean-zero theorem removes the zero mode. The second is proved for matched blocks by E1 under a supplied purity of the joint state, which E1 does not derive, and for general blocks is conditional on that purity, on $[\mathrm{H}_{\mathrm{res}}]$ and on extending
 O17's equal-dimension result to the real pipeline; the
 metaplectic dilation is excluded as a bridge,
 \doi{10.5281/zenodo.20499440}}
}

